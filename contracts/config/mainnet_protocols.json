  "adapter_routing": {
    "mainnet_ready": {
      "endur_btc_lsts": {
        "adapter": "Erc4626VaultAdapter",
        "abi": "ERC4626 deposit(assets, receiver), withdraw(assets, receiver, owner), convert_to_assets(shares), asset()",
        "assets": ["wbtc", "tbtc", "lbtc", "solvbtc"],
        "status": "ready_after_configuring_each_underlying_asset_to_its_lst_vault"
      },
      "vesu_supply_vtokens": {
        "adapter": "Erc4626VaultAdapter",
        "abi": "Vesu V2 vToken ERC4626",
        "status": "ready_after_resolving_pool_asset_vtoken_addresses_from_pool_factory_or_curator_dashboard"
      },
      "vesu_collateral_borrow": {
        "adapter": "LeveragedVaultAdapter",
        "abi": "Vesu V2 Pool modify_position(ModifyPositionParams), position(...), check_collateralization(...)",
        "status": "abi_aligned_with_official_vesu_v2_pool_source"
      },
      "zero_d_usdc_carry": {
        "adapter": "Erc4626VaultAdapter",
        "abi": "ERC4626-compatible vault route pending final explorer ABI check",
        "status": "address_available"
      },
      "ekubo_liquidity": {
        "adapter": "EkuboAdapter",
        "abi": "Ekubo Positions mint_v2, deposit_amounts, withdraw_v2, collect_fees, get_token_info",
        "status": "abi_aligned_with_official_ekubo_positions_source"
      }
    },
    "not_routed_until_manual_discovery": {
      "troves": "strategy contracts are listed inside each strategy manage tab, not in public contract docs",
      "noon": "official docs publish USN/sUSN tokens but no Starknet staking or vault contract"
    }
  },
